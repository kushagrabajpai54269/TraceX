# TraceX Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
# Get from: Atlas Dashboard → Database → Connect → Drivers → Node.js
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<AppName>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tracex?retryWrites=true&w=majority&appName=TraceX

# Etherscan API V2 key — https://etherscan.io/myapikey
# Free tier: 5 requests/second, 100,000 requests/day
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Phase 7: AI Investigation Assistant ──────────────────────
# OpenAI API key — https://platform.openai.com/api-keys
# Never commit your real key. Keep it here only.
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (default: gpt-4o-mini). Other options: gpt-4o, gpt-3.5-turbo
AI_MODEL=gpt-4o-mini
